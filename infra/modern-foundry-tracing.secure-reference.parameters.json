{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "accountName": { "value": "<existing-account-name>" },
    "projectName": { "value": "<existing-project-name>" },
    "appInsightsConnectionName": { "value": "<exact-reviewed-name>" },
    "appInsightsResourceId": { "value": "/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Insights/components/<component-name>" },
    "tracingAssociationMode": { "value": "preserveExisting" },
    "appInsightsConnectionSharing": { "value": "private" },
    "appInsightsConnectionPeRequirement": { "value": "NotRequired" },
    "appInsightsConnectionPeStatus": { "value": "NotApplicable" },
    "appInsightsConnectionPropertiesReviewed": { "value": false },
    "appInsightsConnectionString": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.KeyVault/vaults/<approved-vault>"
        },
        "secretName": "appinsights-connection-string",
        "secretVersion": "<approved-existing-version>"
      }
    }
  }
}
