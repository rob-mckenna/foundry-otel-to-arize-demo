# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Squad: per-agent isolated git worktrees (local scratch space, never committed)
.worktrees/

# Azure CLI config relocated into the repo (AZURE_CONFIG_DIR) so the sandboxed
# coding agent's workspace-scoped filesystem boundary can reach it. Contains
# cached auth tokens - never commit.
.azure-config/
